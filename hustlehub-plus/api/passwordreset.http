@base = https://localhost:5000/api

### Existing account - 200, email arrives in Mailpit
POST {{base}}/auth/forgot-password
Content-Type: application/json

{ "email": "client@test.com" }

### Unknown account - 200, same message, no email
POST {{base}}/auth/forgot-password
Content-Type: application/json

{ "email": "nobody@test.com" }

### Weak password - 400
POST {{base}}/auth/reset-password
Content-Type: application/json

{ "token": "PASTE_TOKEN_FROM_EMAIL", "password": "weak" }

### Valid reset - 200
POST {{base}}/auth/reset-password
Content-Type: application/json

{ "token": "PASTE_TOKEN_FROM_EMAIL", "password": "NewPassword123!" }

### Same link again - 400
POST {{base}}/auth/reset-password
Content-Type: application/json

{ "token": "PASTE_TOKEN_FROM_EMAIL", "password": "AnotherPass123!" }

### Malformed token - 400
POST {{base}}/auth/reset-password
Content-Type: application/json

{ "token": "abc", "password": "NewPassword123!" }

@base = https://localhost:5000/api
@password = QwertyTest123!

### Register a new freelancer - should be 201 (401 if run again)
POST {{base}}/auth/register
Content-Type: application/json

{
  "email": "freelancer@test.com",
  "password": "{{password}}",
  "name": "Free",
  "surname": "Lancer",
  "displayName": "Lancer Designs",
  "role": "freelancer"
}

### Register a client - should be 201 (401 if run again)
POST {{base}}/auth/register
Content-Type: application/json

{
  "email": "client@test.com",
  "password": "{{password}}",
  "name": "Cli",
  "surname": "Ent",
  "displayName": "Client",
  "role": "client"
}


  "item": [
    {
      "name": "00 - Register client",
      "request": {
        "method": "POST",
        "url": "https://localhost:5000/api/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"name\": \"RBAC Test Client\",\r\n  \"surname\": \"Tester\",\r\n  \"displayName\": \"RBAC Client\",\r\n  \"email\": \"rbac.client@test.com\",\r\n  \"password\": \"TestPassword123!\",\r\n  \"role\": \"client\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test(\"Client registration succeeds or account already exists\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 409]);",
              "});",
              "",
              "pm.test(\"Client registration returns an expected response\", function () {",
              "    const response = pm.response.json();",
              "",
              "    if (pm.response.code === 200 || pm.response.code === 201) {",
              "        pm.expect(response).to.be.an(\"object\");",
              "    } else {",
              "        pm.expect(response.error).to.be.a(\"string\");",
              "",
              "        const error = response.error.toLowerCase();",
              "",
              "        pm.expect(",
              "            error.includes(\"already\") ||",
              "            error.includes(\"exist\") ||",
              "            error.includes(\"duplicate\")",
              "        ).to.be.true;",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "00.1 Register freelancer",
      "request": {
        "method": "POST",
        "url": "https://localhost:5000/api/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"name\": \"RBAC\",\r\n  \"surname\": \"Freelancer\",\r\n  \"displayName\": \"RBAC Freelancer A\",\r\n  \"email\": \"rbac.freelancer@test.com\",\r\n  \"password\": \"TestPassword123!\",\r\n  \"role\": \"freelancer\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test(\"Freelancer registration succeeds or account already exists\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 409]);",
              "});",
              "",
              "pm.test(\"Freelancer registration returns an expected response\", function () {",
              "    const response = pm.response.json();",
              "",
              "    if ([200, 201].includes(pm.response.code)) {",
              "        pm.expect(response).to.be.an(\"object\");",
              "    } else {",
              "        const message = response.error || response.message || \"\";",
              "",
              "        pm.expect(message).to.be.a(\"string\").and.not.empty;",
              "        pm.expect(message.toLowerCase()).to.match(/already|exist|duplicate/);",
              "    }",
              "});"
            ]
          }
        }
      ]
    },

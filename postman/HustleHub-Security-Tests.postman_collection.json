      "event": [
        {
          "listen": "test",
          "script": {
            "id": "3d662bfe-b1cc-4d32-8b06-7d7a9ff769c8",
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Freelancer cannot edit another user's gig\", function () {",
              "    pm.response.to.have.status(403);",

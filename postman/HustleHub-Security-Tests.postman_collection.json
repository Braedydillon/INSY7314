            "type": "text/javascript",
            "exec": [
              "",
              "pm.test(\"Freelancer can view own gigs - 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Created gig appears in freelancer's gigs\", function () {",
              "    const response = pm.response.json();",
              "    const gigId = pm.collectionVariables.get(\"createdGigId\");",
              "",
              "    pm.expect(response.gigs).to.be.an(\"array\");",
              "    pm.expect(gigId, \"Created gig ID must be saved\").to.be.a(\"string\");",
              "",
              "    const gig = response.gigs.find(g => g.id === gigId);",
              "",
              "    pm.expect(gig, \"Created gig should appear in own gigs\").to.exist;",
              "    pm.expect(gig.title).to.eql(\"Lane B Automated Test Gig\");",
              "});"
            ],
            "_lastExecutionId": "0c715288-59ee-4336-8e8d-d589c6708555"
          }

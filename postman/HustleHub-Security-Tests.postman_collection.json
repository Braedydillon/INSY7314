    {
      "name": "4 - Freelancer create Gig",
      "request": {
        "method": "POST",
        "url": "https://localhost:5000/api/gigs",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"title\": \"Lane B Automated Test Gig\",\r\n  \"category\": \"design\",\r\n  \"description\": \"A test gig created to verify freelancer permissions.\",\r\n  \"tiers\": [\r\n    {\r\n      \"title\": \"Basic Package\",\r\n      \"description\": \"A basic website design package.\",\r\n      \"priceCents\": 50000\r\n    }\r\n  ]\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{freelancerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test(\"Freelancer can create a gig - 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Created gig belongs to freelancer\", function () {",
              "    const response = pm.response.json();",
              "",
              "    pm.expect(response.gig).to.be.an(\"object\");",
              "    pm.expect(response.gig.title).to.eql(\"Lane B Automated Test Gig\");",
              "    pm.expect(response.gig.freelancerId).to.be.a(\"string\");",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    const response = pm.response.json();",
              "    pm.collectionVariables.set(\"createdGigId\", response.gig.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "5 - Freelancer views own gigs",
      "request": {
        "method": "GET",
        "url": "https://localhost:5000/api/gigs/mygigs",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{freelancerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test(\"Freelancer can view own gigs - 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Created gig appears in freelancer's gigs\", function () {",
              "    const response = pm.response.json();",
              "    const gigId = pm.collectionVariables.get(\"createdGigId\");",
              "",
              "    pm.expect(response.gigs).to.be.an(\"array\");",
              "    pm.expect(gigId, \"Created gig ID must be saved\").to.be.a(\"string\");",
              "",
              "    const gig = response.gigs.find(g => g.id === gigId);",
              "",
              "    pm.expect(gig, \"Created gig should appear in own gigs\").to.exist;",
              "    pm.expect(gig.title).to.eql(\"Lane B Automated Test Gig\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6 - Freelancer cannot edit another gig",
      "request": {
        "method": "PUT",

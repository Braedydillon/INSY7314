        ],
        "method": "PUT",
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"title\": \"Unauthorized Gig Update\",\r\n  \"category\": \"design\",\r\n  \"description\": \"Attempting to update a gig belonging to another freelancer.\",\r\n  \"tiers\": [\r\n    {\r\n      \"title\": \"Basic Package\",\r\n      \"description\": \"A basic website design package.\",\r\n      \"priceCents\": 50000\r\n    }\r\n  ]\r\n}",

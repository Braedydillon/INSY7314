    {
      "name": "0 - Login as Client",
      "request": {
        "method": "POST",
        "url": "https://localhost:5000/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"rbac.client@test.com\",\r\n  \"password\": \"TestPassword123!\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test(\"Client login succeeds - 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Client login returns a JWT\", function () {",
              "    const response = pm.response.json();",
              "",
              "    pm.expect(response.token).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    const response = pm.response.json();",
              "",
              "    pm.collectionVariables.set(\"clientToken\", response.token);",
              "}"
            ]
          }
        }
      ]
    },

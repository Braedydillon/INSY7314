    {
      "id": "d4393321-ca3d-4bf8-8d88-674f5596ee24",
      "name": "00 - Register client",
      "request": {
        "url": {
          "protocol": "https",
          "port": "5000",
          "path": [
            "api",
            "auth",
            "register"
          ],
          "host": [
            "localhost"
          ],
          "query": [],
          "variable": []
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"name\": \"RBAC Test Client\",\r\n  \"surname\": \"Tester\",\r\n  \"displayName\": \"RBAC Client\",\r\n  \"email\": \"rbac.client@test.com\",\r\n  \"password\": \"TestPassword123!\",\r\n  \"role\": \"client\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth",
          "noauth": []
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "82d68410-bd09-45c1-a458-238bd5637582",
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test(\"Client registration succeeds or account already exists\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 409]);",
              "});",
              "",
              "pm.test(\"Client registration returns an expected response\", function () {",
              "    const response = pm.response.json();",
              "",
              "    if (pm.response.code === 200 || pm.response.code === 201) {",
              "        pm.expect(response).to.be.an(\"object\");",
              "    } else {",
              "        pm.expect(response.error).to.be.a(\"string\");",
              "",
              "        const error = response.error.toLowerCase();",
              "",
              "        pm.expect(",
              "            error.includes(\"already\") ||",
              "            error.includes(\"exist\") ||",
              "            error.includes(\"duplicate\")",
              "        ).to.be.true;",
              "    }",
              "});"
            ],
            "_lastExecutionId": "8cd35aea-b1d9-4486-a617-b27d9bec0685"
          }
        }
      ]
    },
